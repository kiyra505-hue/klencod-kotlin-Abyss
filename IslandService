package com.islandultra.app

import android.animation.ValueAnimator
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Intent
import android.graphics.Color
import android.graphics.PixelFormat
import android.graphics.drawable.GradientDrawable
import android.os.Build
import android.os.IBinder
import android.view.Gravity
import android.view.View
import android.view.WindowManager
import android.view.animation.OvershootInterpolator
import android.widget.FrameLayout
import android.widget.LinearLayout
import android.widget.TextView

class IslandService : Service() {

    private lateinit var windowManager: WindowManager
    private lateinit var islandView: FrameLayout
    private lateinit var params: WindowManager.LayoutParams
    private var isExpanded = false

    // مقاسات الجزيرة
    private val collapsedWidth = 150
    private val collapsedHeight = 80
    private val expandedWidth = 800
    private val expandedHeight = 250

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        windowManager = getSystemService(WINDOW_SERVICE) as WindowManager
        createNotificationChannel()
        showIsland()
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel("island_channel", "Island Service", NotificationManager.IMPORTANCE_LOW)
            val manager = getSystemService(NotificationManager::class.java)
            manager.createNotificationChannel(channel)
            val notification = Notification.Builder(this, "island_channel")
                .setContentTitle("الجزيرة تعمل")
                .setContentText("الجزيرة التفاعلية شغالة في الخلفية")
                .setSmallIcon(android.R.drawable.ic_menu_info_details)
                .build()
            startForeground(1, notification)
        }
    }

    private fun dpToPx(dp: Int): Int {
        return (dp * resources.displayMetrics.density).toInt()
    }

    private fun showIsland() {
        // إنشاء شكل الجزيرة (باكغراوند أسود بحواف دائرية كاملة)
        val shape = GradientDrawable()
        shape.shape = GradientDrawable.RECTANGLE
        shape.cornerRadius = 100f
        shape.setColor(Color.BLACK)
        // تأثير الحواف الشفافة (ظل خفيف)
        shape.setStroke(2, Color.parseColor("#33FFFFFF")) 

        islandView = FrameLayout(this)
        islandView.background = shape

        // نص تجريبي داخل الجزيرة
        val textView = TextView(this)
        textView.text = "🎵"
        textView.textSize = 24f
        textView.setTextColor(Color.WHITE)
        textView.gravity = Gravity.CENTER
        islandView.addView(textView)

        // إعدادات ظهور النافذة فوق كل التطبيقات
        params = WindowManager.LayoutParams(
            dpToPx(collapsedWidth),
            dpToPx(collapsedHeight),
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY else WindowManager.LayoutParams.TYPE_PHONE,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        )
        params.gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
        params.y = dpToPx(10) // المسافة من أعلى الشاشة

        windowManager.addView(islandView, params)

        // عند اللمس: تتوسع أو تصغر بأنيميشن ناعم
        islandView.setOnClickListener {
            animateIsland(!isExpanded)
        }
    }

    private fun animateIsland(expand: Boolean) {
        isExpanded = expand

        val startWidth = params.width
        val endWidth = dpToPx(if (expand) expandedWidth else collapsedWidth)
        
        val startHeight = params.height
        val endHeight = dpToPx(if (expand) expandedHeight else collapsedHeight)

        // أنيميشن العرض والطول
        val animator = ValueAnimator.ofFloat(0f, 1f)
        animator.duration = 400 // سرعة الأنيميشن (400 ملي ثانية)
        animator.interpolator = OvershootInterpolator(0.8f) // ارتداد ناعم وجميل

        animator.addUpdateListener { animation ->
            val fraction = animation.animatedFraction
            params.width = (startWidth + (endWidth - startWidth) * fraction).toInt()
            params.height = (startHeight + (endHeight - startHeight) * fraction).toInt()
            windowManager.updateViewLayout(islandView, params)
        }

        animator.start()
    }

    override fun onDestroy() {
        super.onDestroy()
        if (this::islandView.isInitialized) {
            windowManager.removeView(islandView)
        }
    }
}